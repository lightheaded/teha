#!/usr/bin/env bash
# Read one teha development secret.
#
# Every secret this project needs lives in one SOPS file, encrypted to an age
# key that sits on this machine. Nothing here needs a password manager, and no
# command in this repository needs one. If you find yourself reaching for `op`,
# read docs/DEV-SECRETS.md first: the value is almost certainly here already.
#
# Usage:
#   scripts/secret --list                 print the names, never the values
#   scripts/secret device_token           print one value, with no newline
#   scripts/secret --file keystore_jks    write the keystore to a temp file
#
# The value goes to standard output and nowhere else. Never redirect it into a
# file that survives, and never pass it as a command argument: an argument is
# visible in the process list to every other process on the machine. Use it
# through an environment variable or a pipe.
set -euo pipefail

store="${TEHA_SECRETS:-$HOME/.config/teha/secrets.enc.yaml}"
key="${TEHA_AGE_KEY:-$HOME/.config/teha/age.key}"

# The key is named here on purpose, rather than left to the ambient
# SOPS_AGE_KEY_FILE. That variable holds one path, and a host that points it at
# another project's key would break every read here. Depending on ambient
# configuration is what makes a secret feel unreachable, and an unreachable
# secret is what sends a person back to a password manager prompt.
if [ -f "$key" ]; then
  export SOPS_AGE_KEY_FILE="$key"
fi

if [ ! -f "$store" ]; then
  echo "secret: no secret store at $store" >&2
  echo "secret: read docs/DEV-SECRETS.md to build one" >&2
  exit 1
fi

read_one() {
  # --extract keeps the value alone. Decrypting the whole file and cutting a
  # line with sed would put every other secret through the pipe as well.
  sops -d --extract "[\"$1\"]" "$store"
}

case "${1:-}" in
  ""|-h|--help)
    sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  --list)
    # The key names, from the encrypted file. A name is not a secret.
    grep -oE '^[a-z0-9_]+:' "$store" | sed 's/:$//' | grep -v '^sops$'
    exit 0
    ;;
  --file)
    name="${2:?secret: --file needs a name}"
    case "$name" in
      keystore_jks)
        out="$(mktemp -t teha-keystore)"
        chmod 600 "$out"
        read_one keystore_jks_base64 | tr -d '\n' | base64 -d > "$out"
        echo "$out"
        ;;
      *)
        echo "secret: --file knows keystore_jks only" >&2
        exit 1
        ;;
    esac
    exit 0
    ;;
esac

read_one "$1"
