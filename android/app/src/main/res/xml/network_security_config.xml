<!-- A self hosted server often runs on a private address with no certificate.
     Cleartext therefore stays available. Use HTTPS on any server that leaves
     your own network. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
