<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13 and later ask for this before any notification is drawn.
         Without it every notify() is dropped in silence. The app asks for it
         the first time the list screen opens, and it works with it refused:
         the nudge is then only the row appearing in the list. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".TehaApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Teha"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The capture window. It floats over whatever is on the screen, so a
             task reaches the outbox without a context switch. -->
        <!--
            exported="false" on purpose. Only the tile in this app starts it,
            through a PendingIntent that carries this app's own identity, so no
            export is needed. Exported, any installed app could pop the capture
            window over whatever is on screen.
        -->
        <activity
            android:name=".QuickAddActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=":quickadd"
            android:theme="@style/Theme.Teha.Transparent"
            android:windowSoftInputMode="adjustResize|stateVisible" />

        <!-- The share target. It is a subclass of the capture window and it
             is exported, which the window itself is not: a share sheet needs
             an exported activity, and nothing else may pop the capture window
             over whatever is on the screen. It accepts one action and one
             type, and what arrives is a draft that the user still sends. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=":quickadd"
            android:label="@string/share_label"
            android:theme="@style/Theme.Teha.Transparent"
            android:windowSoftInputMode="adjustResize|stateVisible">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".tile.QuickAddTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_add"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>
    </application>
</manifest>
